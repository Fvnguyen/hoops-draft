NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Session pooler URI (Dashboard -> Project Settings -> Database -> Connection string ->
# URI, "Session pooler" mode) — used only by scripts/run-migration.mjs, never at runtime.
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# Dedicated Playwright login (scripts/bootstrap-e2e-user.mjs, tests/auth.setup.ts) — never
# the real admin account. A plus-addressed alias of your own email works fine.
E2E_TEST_EMAIL=you+e2e@example.com
E2E_TEST_PASSWORD=a-password-at-least-10-chars
# pvp_match: a second dedicated login, needed for any two-player (PvP/Playoffs) Playwright
# spec (e.g. tests/playoffs-invite.spec.ts). Optional — bootstrap:e2e skips it if unset.
E2E_TEST_EMAIL_2=you+e2e2@example.com
E2E_TEST_PASSWORD_2=a-password-at-least-10-chars