# --- dependencies ---
node_modules/

# --- Next.js / build output ---
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
frontend/next-env.d.ts

# --- test artifacts ---
frontend/playwright-report/
frontend/test-results/
coverage/

# --- Playwright auth fixture: live session cookies, never committed ---
frontend/tests/.auth/

# --- python ---
__pycache__/
*.pyc
.venv/

# --- runtime game logs (exported from /debug; regenerate, don't commit) ---
data/game_logs/*
!data/game_logs/.gitkeep
data/fetch.log

# --- screenshots / scratch images (dev artifacts, not source) ---
screenshot*.png
*_screenshot.png
mock-*.png

# --- env / OS ---
.env*
!.env.example
!frontend/.env.example
.DS_Store
Thumbs.db
*.pem

# local screenshot output from scripts/screenshot.js
screenshots/

# ad-hoc verification screenshots dropped in the app folder by agents
frontend/*.png

.vercel

# supabase CLI scratch dir
frontend/supabase/.temp/
